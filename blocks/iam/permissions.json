      "blocks-data::file::get-file"
    ],
    "mentee": [
      "mentormatch::profiles::read-own-mentee",
      "mentormatch::profiles::write-own-mentee",
      "mentormatch::profiles::read-public-mentors",
      "mentormatch::ui::dashboard",
      "mentormatch::ui::profile-settings",
      "mentormatch::ui::mentee-section",
      "blocks-iam::auth::change-password"
    ],
    "admin": [
      "mentormatch::profiles::read-own-mentor",
      "mentormatch::profiles::write-own-mentor",
      "mentormatch::profiles::read-own-mentee",
      "mentormatch::profiles::write-own-mentee",
      "mentormatch::profiles::read-public-mentors",
      "mentormatch::admin::view-all-profiles",
      "mentormatch::admin::manage-users",
      "mentormatch::ui::dashboard",
      "mentormatch::ui::profile-settings",
      "mentormatch::ui::mentor-section",
