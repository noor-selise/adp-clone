      "mentormatch::storage::upload-profile-photo",
      "blocks-iam::auth::change-password",
      "blocks-iam::iam::mutate-users",
      "blocks-iam::iam::mutate-roles",
      "blocks-iam::iam::mutate-permissions",
      "blocks-iam::iam::mutate-security-audit",
      "blocks-data::file::get-pre-signed-url-for-upload",
      "blocks-data::file::get-file"
    ]
