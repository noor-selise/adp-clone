{
  "schemaName": "MentorProfile",
  "collectionName": "MentorProfiles",
  "schemaType": 1,
  "fields": [
    { "name": "userId", "type": "String", "isRequired": true, "description": "IAM user id owning this profile" },
    { "name": "displayName", "type": "String", "isRequired": true, "description": "Public display name" },
    { "name": "photoFileId", "type": "String", "isRequired": false, "description": "Storage file id for profile photo" },
    { "name": "title", "type": "String", "isRequired": false, "description": "Job title" },
    { "name": "company", "type": "String", "isRequired": false, "description": "Company name" },
    { "name": "bio", "type": "String", "isRequired": false, "description": "Short bio" },
    { "name": "skills", "type": "String", "isArray": true, "isRequired": false, "description": "Skill tags" },
    { "name": "languages", "type": "String", "isArray": true, "isRequired": false, "description": "Spoken languages" },
    { "name": "timezone", "type": "String", "isRequired": false, "description": "IANA timezone" },
    { "name": "companyVerificationStatus", "type": "String", "isRequired": false, "description": "unverified | pending | verified" }
  ]
}
