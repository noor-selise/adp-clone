  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime Ownership",
      "items": [
        "App team owns the Next.js app and its server-side use of the SDK",
        "Platform (SELISE Blocks) owns IAM, Data, Storage, Mail, Notification",
        "The video vendor is a swappable third party behind one internal interface"
      ]
    },
    {
      "dot": "rose",
      "title": "Named Crossings",
      "items": [
        "Browser only ever talks to the Next.js app, never to Blocks or the video vendor directly",
        "Video room tokens are minted server-side; secrets never reach the client",
        "blocks-cli configures and deploys but never sits on the live request path"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why No blocks new web",
      "items": [
        "blocks-cli's scaffolder generates Vite+React, not Next.js",
        "The SDK (@seliseblocks/client) is framework-agnostic, so it's wired into Next.js manually",
        "blocks-cli still owns Data/IAM/Release for this project regardless of frontend framework"
      ]
    }
  ]
