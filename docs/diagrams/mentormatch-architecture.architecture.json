  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime Ownership",
      "items": [
        "App team owns the Next.js app, SDK, and scheduled jobs",
        "Platform owns IAM, Data, Storage, Mail, Notification, Localization",
        "The video vendor is a swappable third party behind one interface"
      ]
    },
    {
      "dot": "rose",
      "title": "Named Crossings",
      "items": [
        "Browser only talks to Next.js, never Blocks or the video vendor",
        "Video room tokens are minted server-side; secrets never reach the client",
        "blocks-cli configures and deploys; never on the live request path"
      ]
    },
    {
      "dot": "amber",
      "title": "Off the Request Path",
      "items": [
        "blocks-cli scaffolds Vite+React, not Next.js; SDK wired in manually",
        "Scheduled Jobs send reminders, mark sessions completed, expire tokens",
        "CI/CD triggers blocks-cli for schema sync and release deploy"
      ]
    }
  ]
