{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "test/index.ts",
    "lib/**/*.test.ts",
    "components/**/*.test.ts",
    "app/**/*.test.ts",
    "scripts/**/*.test.mjs"
  ],
  "exclude": ["node_modules"]
}
