{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:https",
    "dev:app": "node scripts/run-next-dev.mjs",
    "dev:proxy": "node scripts/https-proxy.mjs",
    "dev:https": "node scripts/run-dev-https.mjs",
    "free-port": "node scripts/free-port.mjs",
    "cert": "node scripts/generate-cert.mjs",
    "trust-cert": "bash scripts/trust-cert.sh",
    "hosts": "bash scripts/add-hosts-entry.sh",
    "build": "next build",
    "build:dev": "next build",
    "build:stg": "next build",
    "build:prod": "next build",
    "start": "next start -p 8083",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test lib/onboarding/*.test.ts lib/profiles/*.test.ts lib/mentorship/*.test.ts scripts/local-bind-host.test.mjs",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "prepare": "cd .. && husky web/.husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": "prettier --write"
  },
  "dependencies": {
    "@seliseblocks/client": "^0.2.0",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "selfsigned": "^2.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
