    "dev:proxy": "node scripts/https-proxy.mjs",
    "dev:https": "node scripts/run-dev-https.mjs",
    "free-port": "node scripts/free-port.mjs",
    "cert": "node scripts/generate-cert.mjs",
    "trust-cert": "bash scripts/trust-cert.sh",
    "hosts": "bash scripts/add-hosts-entry.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
